{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "InMemory"
  },
  "Analytics": {
    "Pipeline": "Direct"
  },
  "ShortCodes": {
    "BlockSize": 1000
  },
  "ShortLinks": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimits": {
    "AnonymousCreatesPerMinute": 10,
    "ApiKeyCreatesPerMinute": 120,
    "RegistrationsPerHour": 5
  }
}
